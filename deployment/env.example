# ════════════════════════════════════════════════════════════════════
#  RWAiSE — environment variable reference
#  Copy to ".env" at the repo root and fill in real values.
#  NEVER commit .env to git — it's gitignored for a reason.
# ════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────
#  TIER 0 · plugin master switches  (REQUIRED to bring it up)
# ────────────────────────────────────────────────────────────────────

# Cluster-wide kill switch. When 0, the entire RWAiSE plugin disappears.
RWAISE_ENABLED=1

# Sub-flag floors. Each sub-flag has 3 layers: env-var floor → DB
# toggle → Redis cache. Setting these to 1 forces ON regardless of
# admin DB action. Leave UNSET to let admins control them.
RWAISE_FEATURE_WIZARD=1
RWAISE_FEATURE_AI_COPILOT=1
RWAISE_FEATURE_CREDENTIALS=1
RWAISE_FEATURE_ORDERBOOK=1
RWAISE_FEATURE_ESCROW=1
RWAISE_FEATURE_REDEMPTION=1
RWAISE_FEATURE_X402=1
RWAISE_FEATURE_BEDROCK_AGENT=1
RWAISE_FEATURE_DEVELOPER_API=1
RWAISE_FEATURE_ODL=0
RWAISE_FEATURE_HSM_SIGNER=0
RWAISE_FEATURE_LIVE_BROADCAST=0   # keep 0 in dev — sha256 mock tx hashes

# ────────────────────────────────────────────────────────────────────
#  TIER 1 · Coinbase Developer Platform  (real market data)
# ────────────────────────────────────────────────────────────────────

# Either set the legacy HMAC pair (most common):
COINBASE_API_KEY=
COINBASE_API_SECRET=
# COINBASE_API_PASSPHRASE=    # ONLY set this for old Coinbase Pro keys

# OR set the modern CDP JWT pair (mutually exclusive with HMAC):
# CDP_API_KEY_NAME=organizations/{org-uuid}/apiKeys/{key-uuid}
# CDP_API_KEY_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ────────────────────────────────────────────────────────────────────
#  TIER 2 · AWS Bedrock  (optional — enables real Claude responses)
# ────────────────────────────────────────────────────────────────────

# Without these set, the agent uses a rule-based engine that still
# returns real Coinbase data. With these set + boto3 installed, real
# Claude Sonnet 4.6 takes over.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
RWAISE_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# Optional: legacy Bedrock Agent path instead of Converse API
# AWS_BEDROCK_AGENT_ID=
# AWS_BEDROCK_AGENT_ALIAS_ID=

# ────────────────────────────────────────────────────────────────────
#  TIER 3 · XRPL signing  (for x402 micropayments + on-ledger transfers)
# ────────────────────────────────────────────────────────────────────

XRPL_RPC_URL=https://xrplcluster.com
# RWAISE_RPC_URL=https://s.altnet.rippletest.net:51234   # override for testnet

# Platform addresses
RWAISE_PLATFORM_ADDRESS=
RWAISE_FEE_RECEIVER=

# Optional: hardware-backed signing
# RWAISE_PLATFORM_CLOUDHSM_LABEL=
# AWS_KMS_KEY_ID=

# ────────────────────────────────────────────────────────────────────
#  TIER 4 · Spending caps  (defaults shown — usually fine)
# ────────────────────────────────────────────────────────────────────

RWAISE_AGENT_SESSION_CAP_USD=1.00
RWAISE_X402_FACILITATOR_URL=/api/v1/coindesk-proxy

# ────────────────────────────────────────────────────────────────────
#  TIER 5 · Mock overrides  (DO NOT SET in production)
# ────────────────────────────────────────────────────────────────────

# Setting any of these to 1 forces mock data. ONLY use for offline dev.
# RWAISE_BEDROCK_MOCK=0
# RWAISE_COINDESK_MOCK=0
# RWAISE_AGENT_MOCK=0

# ────────────────────────────────────────────────────────────────────
#  Host Gopnik wallet — required for the plugin to run
# ────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://gopnik:gopnik@localhost:5432/gopnik
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string-32-chars-or-more
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
